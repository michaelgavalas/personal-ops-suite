DATABASE_URL=postgresql://postgres:postgres@localhost:5432/personal_ops

# Development listens on a TCP port. Production sets API_SOCKET_PATH instead,
# which takes precedence and switches the server to a unix socket.
API_PORT=5000

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me

# The public origin the browser uses, with no path — a path here stops Better
# Auth matching any route. Cookie attributes and OAuth callbacks derive from
# it, not from the address the API is actually reached on. The auth app, since
# that is where signing in happens.
BETTER_AUTH_URL=http://localhost:3001

# The tools proxy /api/auth on their own origins to read the session and sign
# out, so requests arrive under more than one Origin and Better Auth turns away
# any it was not told to expect. Comma-separated; add an entry per tool.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3001,http://localhost:3000

# Production only. Scopes the session cookie to the parent domain so one
# sign-in covers every subdomain; docker-compose.prod.yml derives it from
# ROOT_DOMAIN. Left unset in development, where the apps differ only by port
# and cookies ignore the port anyway.
# AUTH_COOKIE_DOMAIN=.example.com

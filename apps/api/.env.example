DATABASE_URL=postgresql://postgres:postgres@localhost:5432/personal_ops

# Development listens on a TCP port. Production sets API_SOCKET_PATH instead,
# which takes precedence and switches the server to a unix socket.
API_PORT=5000

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me

# The public origin the browser uses, with no path — a path here stops Better
# Auth matching any route. Cookie attributes and OAuth callbacks derive from
# it, not from the address the API is actually reached on.
BETTER_AUTH_URL=http://localhost:3000

# Development reaches the API over TCP. Production sets API_SOCKET_PATH
# instead, which takes precedence and switches to the unix socket.
API_URL=http://localhost:5000

# This app's own public origin, and the auth app's. proxy.ts builds the
# sign-in redirect from both. Configured rather than read off the request:
# behind Caddy the request carries the internal container address.
APP_URL=http://localhost:3000
AUTH_URL=http://localhost:3001

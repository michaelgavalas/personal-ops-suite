# Development reaches the API over TCP. Production sets API_SOCKET_PATH
# instead, which takes precedence and switches to the unix socket.
API_URL=http://localhost:5000

# Where people land after signing in when the request names no destination,
# or names one that is not trusted. No tool exists yet, so this is the auth
# app's own page — point it at the first one that gets built.
DEFAULT_REDIRECT_URL=http://localhost:3001

# Origins a ?redirect_to= is allowed to point at, comma-separated. Anything
# else is discarded and DEFAULT_REDIRECT_URL is used, which is what keeps this
# from being an open redirect on the domain people type passwords into.
ALLOWED_REDIRECT_ORIGINS=http://localhost:3001

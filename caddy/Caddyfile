{
	email {$ACME_EMAIL}
}

# Stock Caddy registers only these two encoders; brotli would need a custom
# binary built with the cbrotli plugin, and an unregistered name here is a
# hard startup failure, not a warning.
(common) {
	encode zstd gzip
}

# The only host for now. A tool added later gets its own block on a sibling
# subdomain, which is what lets one session cookie — scoped to the parent
# domain — cover both.
{$AUTH_DOMAIN} {
	import common
	reverse_proxy auth-web:3000
}

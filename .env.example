# Consumed by docker-compose.prod.yml. Copy to .env on the VPS.

# The registrable parent domain. Every app is served from a subdomain of it —
# auth.<root> today — and the session cookie is scoped to it, so a tool added
# later on a sibling subdomain is covered by the same sign-in. Point the
# subdomain at this host in DNS before bringing the stack up, or certificate
# issuance fails.
ROOT_DOMAIN=example.com

ACME_EMAIL=you@example.com
POSTGRES_PASSWORD=change-me
# Consumed by the api, which owns auth. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me

# Consumed by docker-compose.prod.yml. Copy to .env on the VPS.

# The registrable parent domain. Every app is served from a subdomain of it —
# jobs.<root> and auth.<root> — and the session cookie is scoped to it, which
# is what makes one sign-in cover all of them. Point both subdomains at this
# host in DNS before bringing the stack up, or certificate issuance fails.
ROOT_DOMAIN=example.com

ACME_EMAIL=you@example.com
POSTGRES_PASSWORD=change-me
# Consumed by the api, which owns auth. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
